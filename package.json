{
  "name": "real-world-drive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based 3D open-world car simulator on real OpenStreetMap roads",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/artifact-postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:physics": "node tests/run-physics.mjs",
    "test:peds": "node tests/run-physics.mjs tests/pedestrians.sim.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "three": "0.170.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
